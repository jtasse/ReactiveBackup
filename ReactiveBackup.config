{
  "rootCodeDirectory": "C:\\dev\\github",
  "rootBackupDirectory": "C:\\dev\\github\\_BACKUPS",
  "logLevel": "error",
  "backupLevel": "repo-parent",
  "includeRootFiles": true,
  "includedRepoFolders": [],
  "excludedRepoFolders": [],
  "includedRepoSubfolders": [],
  "excludedRepoSubfolders": [
    ".git",
    "node_modules",
    "dist",
    ".next",
    ".venv",
    "__pycache__",
    ".pytest_cache",
    ".aws-sam",
    "logs"
  ],
  "checkForCodeChangesIntervalMinutes": 15,
  "timestampFormat": "yyyyMMdd - hh:mm tt",
  "sendBackupFolderThresholdExceededAlerts": false,
  "backupSizeThresholdMb": 50000,
  "totalBackupSizeThresholdMb": 100000,
  "includeUnconfiguredBackupFoldersInSizeAlerts": false,
  "alertEmail": "",
  "smtpHost": "",
  "smtpPort": 587,
  "smtpUsername": "",
  "smtpPassword": "",
  "smtpFrom": ""
}
